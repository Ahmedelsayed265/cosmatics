{
  "section_id": "uuid",
  "template": "sections/shop-by-category.jinja",
  "icon": "fal fa-home",
  "name": {
    "ar": "تسوق حسب الفئة",
    "en": "Shop by Category"
  },
  "settings": [
    {
      "type": "select",
      "id": "desktop_layout",
      "label": {
        "ar": "تنسيق النسخة المكتبية",
        "en": "Desktop Layout"
      },
      "options": [
        {
          "label": {
            "ar": "عرض مرن (Flex)",
            "en": "Flex Mode"
          },
          "value": "flex"
        },
        {
          "label": {
            "ar": "سلايدر (Swiper)",
            "en": "Swiper Mode"
          },
          "value": "swiper"
        }
      ],
      "default": "flex"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": {
        "ar": "إظهار الأسهم (في وضع السلايدر)",
        "en": "Show Arrows (in Swiper mode)"
      },
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": {
        "ar": "إظهار النقاط (في وضع السلايدر)",
        "en": "Show Pagination (in Swiper mode)"
      },
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": {
        "ar": "العنوان",
        "en": "Title"
      }
    },
    {
      "type": "list",
      "id": "categories",
      "max_items": 16,
      "label": {
        "ar": "الأقسام",
        "en": "Categories"
      },
      "settings": [
        {
          "type": "image",
          "id": "image",
          "label": {
            "ar": "الصورة",
            "en": "Image"
          }
        },
        {
          "type": "text",
          "id": "title",
          "label": {
            "ar": "العنوان",
            "en": "Title"
          }
        },
        {
          "type": "url",
          "id": "url",
          "label": {
            "ar": "الرابط",
            "en": "URL"
          }
        }
      ]
    }
  ]
}
