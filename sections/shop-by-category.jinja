<style>
    @media (min-width: 768px) {
        .shop-by-category-wrapper.is-flex .swiper-wrapper {
            display: flex !important;
            flex-wrap: wrap !important;
            justify-content: center !important;
            gap: 20px;
            transform: none !important;
            width: 100% !important;
            margin: 0 auto;
        }

        .shop-by-category-wrapper.is-flex .swiper-slide {
            width: auto !important;
            margin: 0 !important;
            height: auto !important;
        }

        /* Hide arrows and pagination when in flex mode on desktop */
        .shop-by-category-wrapper.is-flex .swiper-button-next,
        .shop-by-category-wrapper.is-flex .swiper-button-prev,
        .shop-by-category-wrapper.is-flex .swiper-pagination {
            display: none !important;
        }
    }

    /* Standard Swiper controls styling if not already global */
    .shop-by-category-wrapper .swiper-button-next,
    .shop-by-category-wrapper .swiper-button-prev {
        color: var(--primary-color, #000);
    }
    
    .shop-by-category-wrapper .swiper-pagination-bullet-active {
        background: var(--primary-color, #000);
    }
</style>

<section class="shop-by-category-section" style="overflow-x: hidden;" id="{{ sectionId }}" section-id="{{ sectionId }}">
    <div class="container-fluid">
        {% if settings.title %}
        <h3 class="section-title">{{ settings.title }}</h3>
        {% endif %}

        <div class="shop-by-category-wrapper swiper {{ 'is-flex' if (settings.desktop_layout | default('flex')) == 'flex' else 'is-swiper' }}"
            data-layout-desktop="{{ settings.desktop_layout | default('flex') }}"
            data-arrows="{{ (settings.show_arrows | default(true)) | lower }}"
            data-pagination="{{ (settings.show_pagination | default(false)) | lower }}">
            
            <div class="swiper-wrapper">
                {% for category in safeget(settings, 'categories', []) %}
                <div class="swiper-slide">
                    <a href="{{ category.url }}" class="shop-by-category-item">
                        <div class="shop-by-category-image">
                            <img src="{{ image_url(category.image, w=400, q=100, f='auto') }}"
                                alt="{{ category.title }}" loading="lazy">
                        </div>

                        <h6>{{ category.title }}</h6>
                    </a>
                </div>
                {% endfor %}
            </div>

            {% if settings.show_pagination | default(false) %}
            <div class="swiper-pagination"></div>
            {% endif %}

            {% if settings.show_arrows | default(true) %}
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
            {% endif %}
        </div>
    </div>
</section>

<script>
    (function () {
        function initShopByCategorySwiper() {
            var section = document.querySelector('[section-id="{{ sectionId }}"]');
            if (!section) return;

            var sliderEl = section.querySelector('.shop-by-category-wrapper');
            if (!sliderEl) return;

            var desktopLayout = sliderEl.getAttribute('data-layout-desktop');
            var isArrows = sliderEl.getAttribute('data-arrows') === 'true';
            var isPagination = sliderEl.getAttribute('data-pagination') === 'true';

            if (window.Swiper) {
                new Swiper(sliderEl, {
                    slidesPerView: 2.5,
                    spaceBetween: 10,
                    freeMode: true,
                    rtl: document.documentElement.dir === 'rtl',
                    navigation: isArrows ? {
                        nextEl: sliderEl.querySelector('.swiper-button-next'),
                        prevEl: sliderEl.querySelector('.swiper-button-prev'),
                    } : false,
                    pagination: isPagination ? {
                        el: sliderEl.querySelector('.swiper-pagination'),
                        clickable: true,
                    } : false,
                    breakpoints: {
                        480: {
                            slidesPerView: 3.5,
                            spaceBetween: 15,
                        },
                        640: {
                            slidesPerView: 4.5,
                            spaceBetween: 20,
                        },
                        768: {
                            enabled: desktopLayout === 'swiper',
                            slidesPerView: desktopLayout === 'swiper' ? 6 : 'auto',
                            spaceBetween: 20,
                            freeMode: false
                        },
                        1024: {
                            enabled: desktopLayout === 'swiper',
                            slidesPerView: desktopLayout === 'swiper' ? 8 : 'auto',
                            spaceBetween: 20,
                            freeMode: false
                        }
                    }
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initShopByCategorySwiper);
        } else {
            initShopByCategorySwiper();
        }
    })();
</script>
